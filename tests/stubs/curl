#!/usr/bin/env bash
# Test double for curl: writes junk to the -o target (checksum must then fail),
# or fails outright when STUB_CURL_RC is non-zero.
[[ "${STUB_CURL_RC:-0}" -eq 0 ]] || exit "$STUB_CURL_RC"
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "-o" ]]; then echo "not a tarball" > "$2"; shift; fi
  shift
done
